# App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL
# Pooled → use for app (pg Pool)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct → use only for running init.sql manually
DATABASE_DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase Storage
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (Docker)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT
JWT_SECRET=change_me_before_any_deploy
JWT_EXPIRES_IN=7d


RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:3000

# super-admin init
SUPER_ADMIN_EMAIL=super-admin@localhost
SUPER_ADMIN_PASSWORD=change_me
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

#Groq
GROQ_API_KEY=gsk_your_groq_api_key

# Huggingface
HUGGINGFACE_API_KEY=hf_your_huggingface_key
HUGGINGFACE_MODEL=Salesforce/blip-image-captioning-large
